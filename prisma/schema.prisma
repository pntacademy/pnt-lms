generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                 @id @default(cuid())
  studentId       String?                @unique
  email           String?                @unique
  passwordHash    String?
  name            String?
  role            Role                   @default(STUDENT)
  className       String?
  instituteName   String?
  age             Int?
  contactNumber   String?
  avatarUrl       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  schoolGradeId   String?
  schoolId        String?
  customStatus    String?
  plainPassword   String?
  studentStatus   StudentStatus          @default(STUDENT)
  lastTestsVisit        DateTime?
  lastVideosVisit       DateTime?
  lastAssignmentsVisit  DateTime?
  lastSchoolVisit       DateTime?
  lastCalendarVisit     DateTime?
  submissions     AssignmentSubmission[]
  taughtCourses   Course[]               @relation("TeacherCourses")
  enrollments     Enrollment[]
  eventsCreated   Event[]                @relation("TeacherEvents")
  notifications   Notification[]
  testSubmissions TestSubmission[]
  schoolGrade     SchoolGrade?           @relation(fields: [schoolGradeId], references: [id])
  school          School?                @relation(fields: [schoolId], references: [id])
  attendance      Attendance[]
}

model School {
  id              String        @id @default(cuid())
  name            String
  coordinatorName String?
  location        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  grades          SchoolGrade[]
  students        User[]
}

model SchoolGrade {
  id                String          @id @default(cuid())
  schoolId          String
  gradeName         String
  videoUrl          String?
  driveLink         String?
  notes             String?
  assignmentLink    String?
  assignmentFileUrl String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  events            Event[]
  materials         GradeMaterial[]
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students          User[]
  videos            GlobalVideo[]
  assignments       Assignment[]
  tests             Test[]
}

model GradeMaterial {
  id          String      @id @default(cuid())
  gradeId     String
  title       String
  description String?
  videoUrl    String?
  fileUrl     String?
  linkUrl     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  grade       SchoolGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
}

model Course {
  id           String        @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?
  isInternship Boolean       @default(false)
  driveLink    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teacherId    String?
  teacher      User?         @relation("TeacherCourses", fields: [teacherId], references: [id])
  topics       CourseTopic[]
  enrollments  Enrollment[]
  events       Event[]
  tests        Test[]
  attendance   Attendance[]
}

model GlobalVideo {
  id          String   @id @default(cuid())
  title       String
  description String?
  driveUrl    String
  driveFileId   String
  schoolGradeId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  schoolGrade   SchoolGrade? @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
}

model CourseTopic {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  description String?
  duration    String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  driveFileId String?
  assignments Assignment[]
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Project {
  title       String
  videoUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  components  String[]
  iconType    String
  objective   String
  programs    String[]
  id          Int          @id
  assignments Assignment[]
}

model Assignment {
  id            String                 @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  projectId     Int?
  courseId      String?
  courseTopicId String?
  schoolGradeId String?
  courseTopic   CourseTopic?           @relation(fields: [courseTopicId], references: [id], onDelete: Cascade)
  project       Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schoolGrade   SchoolGrade?           @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  submissions   AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  userId       String
  assignmentId String
  fileUrl      String?
  studentNotes String?
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
}



model Event {
  id            String        @id @default(cuid())
  title         String
  description   String?
  date          DateTime
  duration      Int?
  type          EventType     @default(CUSTOM)
  courseId      String?
  teacherId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  color         String?
  endDate       DateTime?
  priority      EventPriority @default(MEDIUM)
  schoolGradeId String?
  status        EventStatus   @default(UPCOMING)
  course        Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schoolGrade   SchoolGrade?  @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  teacher       User          @relation("TeacherEvents", fields: [teacherId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Test {
  id          String           @id @default(cuid())
  title       String
  description String?
  courseId    String?
  totalMarks    Int              @default(0)
  isPublished   Boolean          @default(false)
  schoolGradeId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  questions     Question[]
  course        Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schoolGrade   SchoolGrade?     @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  submissions   TestSubmission[]
}

model Question {
  id            String   @id @default(cuid())
  testId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  marks         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestSubmission {
  id         String   @id @default(cuid())
  testId     String
  userId     String
  score      Int
  totalMarks Int
  answers    Json
  createdAt  DateTime @default(now())
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
}

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  date        DateTime @default(now())
  status      AttendanceStatus @default(PRESENT)
  markedBy    String?  // Teacher ID who marked it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum StudentStatus {
  STUDENT
  INTERN
  OTHER
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}



enum EventType {
  LIVE_CLASS
  DEADLINE
  GENERAL
  LESSON_COMPLETION
  UPCOMING_LESSON
  ASSIGNMENT_DEADLINE
  QUIZ
  TEST
  EXAMINATION
  PROJECT_SUBMISSION
  ANNOUNCEMENT
  HOLIDAY
  BATCH_EVENT
  CUSTOM
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
}
