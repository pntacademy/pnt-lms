generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum StudentStatus {
  STUDENT
  INTERN
  OTHER
}

model User {
  id            String    @id @default(cuid())
  studentId     String?   @unique // Generated by teacher (e.g. PNT-2026-001)
  email         String?   @unique // Optional, maybe for teachers/admins
  passwordHash  String?   // For credential login
  plainPassword String?   // For temporary admin visibility of generated passwords
  name          String?
  role          Role      @default(STUDENT)
  studentStatus StudentStatus @default(STUDENT)
  customStatus  String?
  
  // Student Metadata added by teacher
  className     String?
  instituteName String?
  age           Int?
  contactNumber String?
  
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments   Enrollment[]
  submissions   AssignmentSubmission[]
  attendances   Attendance[]
  testSubmissions TestSubmission[]
  notifications Notification[]
  
  // Teacher relations
  taughtCourses Course[] @relation("TeacherCourses")
  eventsCreated Event[]  @relation("TeacherEvents")

  // School relations
  schoolId      String?
  schoolGradeId String?
  school        School?      @relation(fields: [schoolId], references: [id])
  schoolGrade   SchoolGrade? @relation(fields: [schoolGradeId], references: [id])
}

model School {
  id              String   @id @default(cuid())
  name            String
  coordinatorName String?
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grades          SchoolGrade[]
  students        User[]
}

model SchoolGrade {
  id             String   @id @default(cuid())
  schoolId       String
  gradeName      String   // e.g. "Grade 10" or "Standard 12"
  videoUrl       String?
  driveLink      String?
  notes          String?  // Text notes
  assignmentLink String?  // External assignment link like Google Form
  assignmentFileUrl String? // Uploaded assignment file (PDF/Doc)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students       User[]
  materials      GradeMaterial[]
  events         Event[]
}

model GradeMaterial {
  id             String   @id @default(cuid())
  gradeId        String
  title          String
  description    String?
  videoUrl       String?
  fileUrl        String?
  linkUrl        String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grade          SchoolGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnailUrl String?
  isInternship Boolean @default(false)
  driveLink   String?  // Secure Google Drive Link for Internships
  teacherId   String?  // User ID of the teacher assigned to this course
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User?    @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]
  topics      CourseTopic[]
  events      Event[]
  tests       Test[]
}

model GlobalVideo {
  id          String   @id @default(cuid())
  title       String
  description String?
  driveUrl    String
  driveFileId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseTopic {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  driveFileId String?  // Extracted Google Drive File ID
  duration    String?  // e.g. "45 mins"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0) // 0-100%
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Project {
  id          Int      @id // Fixed IDs 1-15
  title       String
  objective   String
  components  String[]
  programs    String[]
  iconType    String
  videoUrl    String?  // YouTube Unlisted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]
}

model Assignment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  projectId     Int?     // Legacy: links to fixed Project catalog
  courseTopicId String?  // New: links to a specific CourseTopic
  courseId      String?  // Denormalized for easy querying by course
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  courseTopic   CourseTopic? @relation(fields: [courseTopicId], references: [id], onDelete: Cascade)
  submissions   AssignmentSubmission[]
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

model AssignmentSubmission {
  id            String   @id @default(cuid())
  userId        String
  assignmentId  String
  fileUrl       String?  // Cloudflare R2 Upload URL
  studentNotes  String?
  status        SubmissionStatus @default(SUBMITTED)
  score         Int?     // e.g. 95/100
  feedback      String?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  date        DateTime @default(now())
  status      AttendanceStatus @default(PRESENT)
  markedBy    String?  // Teacher ID who marked it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, date])
}

enum EventType {
  LESSON_COMPLETION
  UPCOMING_LESSON
  ASSIGNMENT_DEADLINE
  QUIZ
  TEST
  EXAMINATION
  PROJECT_SUBMISSION
  ANNOUNCEMENT
  HOLIDAY
  BATCH_EVENT
  CUSTOM
  LIVE_CLASS
  DEADLINE
  GENERAL
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
}

model Event {
  id            String        @id @default(cuid())
  title         String
  description   String?
  date          DateTime
  endDate       DateTime?
  duration      Int?          // Duration in minutes
  type          EventType     @default(CUSTOM)
  status        EventStatus   @default(UPCOMING)
  priority      EventPriority @default(MEDIUM)
  color         String?
  
  courseId      String?
  schoolGradeId String?
  teacherId     String
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  course        Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schoolGrade   SchoolGrade?  @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)
  teacher       User          @relation("TeacherEvents", fields: [teacherId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  isRead      Boolean  @default(false)
  linkUrl     String?  // Optional link to navigate when clicked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  courseId    String?
  totalMarks  Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions TestSubmission[]
}

model Question {
  id            String   @id @default(cuid())
  testId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  marks         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestSubmission {
  id         String   @id @default(cuid())
  testId     String
  userId     String
  score      Int
  totalMarks Int
  answers    Json     // Stores student's selected options
  createdAt  DateTime @default(now())

  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId]) // Limits to 1 attempt per test per student
}
